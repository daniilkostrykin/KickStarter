# KickStarter — пример переменных окружения (12-Factor App).
#
# Назначение:
#   * Docker Compose автоматически читает файл .env из корня проекта
#     (см. docker-compose.yml: ${VAR:-default}).
#   * Значения ниже — локальные dev-дефолты, при которых проект поднимается. Для production ОБЯЗАТЕЛЬНО замените все секреты.
#
# Как использовать:
#   1. cp .env.example .env        (Windows: copy .env.example .env)
#   2. Заполните значения под своё окружение.
#   3. docker compose up -d
#

# --- PostgreSQL (сервис kickstarter-postgres) --------------------------------
POSTGRES_DB=kickstarter_db
POSTGRES_USER=kickstarter_user
POSTGRES_PASSWORD=kickstarter_password

# --- PostgreSQL (клиентское подключение kickstarter-rest) --------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kickstarter_db
DB_USER=kickstarter_user
DB_PASSWORD=kickstarter_password

# --- RabbitMQ (сервис kickstarter-rabbitmq) ----------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- RabbitMQ (клиентское подключение сервисов) ------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Keycloak (сервис keycloak) ----------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-only
KC_HOSTNAME=http://localhost:8085

# --- Cookie / Session (kickstarter-rest) -------------------------------------
# secure=true включается только при работе по HTTPS.
SESSION_COOKIE_SECURE=false
