{
  "realm": "kickstarter",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "service" },
      { "name": "operator" }
    ]
  },
  "clients": [
    {
      "clientId": "kickstarter-service-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "service-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["roles"],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "audit-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kickstarter-ops-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "ops-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["roles"],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "audit-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kickstarter-other-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "other-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["roles"],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "other-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    { "client": "kickstarter-service-client", "roles": ["service"] },
    { "client": "kickstarter-ops-client", "roles": ["operator"] },
    { "client": "kickstarter-other-client", "roles": ["service"] }
  ],
  "users": [
    {
      "username": "service-account-kickstarter-service-client",
      "enabled": true,
      "serviceAccountClientId": "kickstarter-service-client",
      "realmRoles": ["service"]
    },
    {
      "username": "service-account-kickstarter-ops-client",
      "enabled": true,
      "serviceAccountClientId": "kickstarter-ops-client",
      "realmRoles": ["operator"]
    },
    {
      "username": "service-account-kickstarter-other-client",
      "enabled": true,
      "serviceAccountClientId": "kickstarter-other-client",
      "realmRoles": ["service"]
    }
  ]
}