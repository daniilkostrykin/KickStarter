scalar DateTime

type Project {
    id: ID!
    title: String!
    description: String
    goal: Float!
    pledged: Float!
    status: String!
    deadline: DateTime
    rewards(page: Int = 0, size: Int = 10): RewardConnection!
    author: User
}

type Reward {
    id: ID!
    projectId: ID!
    title: String!
    description: String
    minPrice: Float!
}

type RewardConnection {
    content: [Reward!]!
    totalElements: Int!
    pageInfo: PageInfo!
}

type Pledge {
    pledgeId: ID!
    projectId: ID!
    rewardId: ID!
    amount: Float!
    status: String!
    transactionDate: DateTime!
    sponsor: User
}

type PledgeConnection {
    content: [Pledge!]!
    totalElements: Int!
    pageInfo: PageInfo!
}

type PageInfo {
    pageNumber: Int!
    pageSize: Int!
    totalPages: Int!
    last: Boolean!
}

type ProjectConnection {
    content: [Project!]!
    totalElements: Int!
    pageInfo: PageInfo!
}

type User {
    id: ID!
    username: String!
    email: String!
    backedProjects: [Project]
}

input CreateProjectInput {
    title: String!
    description: String
    goal: Float!
    deadline: DateTime
    authorId: ID!
}

input CreateUserInput {
    username: String!
    email: String!
}

input PatchProjectInput {
    title: String
    description: String
    status: String
}

input CreateRewardInput {
    projectId: ID!
    title: String!
    description: String
    minPrice: Float!
}

input CreatePledgeInput {
    projectId: ID!
    rewardId: ID!
    pledge: Float!
    userId: ID!
}

type Query {
    project(id: ID!): Project
    projects(page: Int = 0, size: Int = 10): ProjectConnection!

    reward(id: ID!): Reward
    rewards(page: Int = 0, size: Int = 10): RewardConnection!

    pledge(id: ID!): Pledge
    pledges(page: Int = 0, size: Int = 10): PledgeConnection!

    user(id: ID!): User
}

type Mutation {
    createProject(input: CreateProjectInput!): Project!
    updateProject(id: ID!, input: PatchProjectInput!): Project!

    createReward(input: CreateRewardInput!): Reward!

    makePledge(input: CreatePledgeInput!): Pledge!

    registerUser(input: CreateUserInput!): User!
}