# application.properties.example
#
# Пример внешней конфигурации kickstarter-rest.
# Скопируйте этот файл в application.properties и замените все CHANGE_ME
# на реальные значения своего окружения
#
# Рабочий src/main/resources/application.properties содержит безопасные
# дефолты, рассчитанные на локальный `docker compose up -d`, поэтому проект
# запускается без этого файла.

spring.application.name=kickstarter-rest

# Активный профиль безопасности.
spring.profiles.active=session-auth
spring.graphql.schema.introspection.enabled=true
spring.graphql.graphiql.enabled=true
spring.graphql.path=/graphql
spring.graphql.schema.locations=classpath*:graphql/
dgs.graphql.schema-locations=classpath*:graphql/**/*.graphqls

# --- PostgreSQL Datasource ---
spring.datasource.url=jdbc:postgresql://CHANGE_ME_DB_HOST:CHANGE_ME_DB_PORT/CHANGE_ME_DB_NAME
spring.datasource.username=CHANGE_ME_DB_USER
spring.datasource.password=CHANGE_ME_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# --- JPA / Hibernate ---
spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# --- Flyway ---
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.locations=classpath:db/migration

# --- RabbitMQ ---
spring.rabbitmq.host=CHANGE_ME_RABBITMQ_HOST
spring.rabbitmq.port=5672
spring.rabbitmq.username=CHANGE_ME_RABBITMQ_USER
spring.rabbitmq.password=CHANGE_ME_RABBITMQ_PASSWORD

# --- Session & Cookie Configuration ---
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=lax
server.servlet.session.cookie.secure=CHANGE_ME_SESSION_COOKIE_SECURE
