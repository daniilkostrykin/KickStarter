scalar DateTime

type Project {
    id: ID!
    title: String!
    description: String
    goal: Float!
    pledged: Float!
    status: String!
    deadline: DateTime
    rewards(page: Int = 0, size: Int = 10): RewardConnection!
}

type Reward {
    id: ID!
    projectId: ID!
    title: String!
    description: String
    minPrice: Float!
}

type RewardConnection {
    content: [Reward!]!
    totalElements: Int!
    pageInfo: PageInfo!
}

type Pledge {
    pledgeId: ID!
    status: String!
    transactionDate: DateTime!
}

type PageInfo {
    pageNumber: Int!
    pageSize: Int!
    totalPages: Int!
    last: Boolean!
}

type ProjectConnection {
    content: [Project!]!
    totalElements: Int!
    pageInfo: PageInfo!
}

input CreateProjectInput {
    title: String!
    description: String
    goal: Float!
    deadline: DateTime
}

input PatchProjectInput {
    title: String
    description: String
    status: String
}

input CreateRewardInput {
    projectId: ID!
    title: String!
    description: String
    minPrice: Float!
}

input CreatePledgeInput {
    projectId: ID!
    rewardId: ID!
    pledge: Float!
}

type Query {
    project(id: ID!): Project
    projects(page: Int = 0, size: Int = 10): ProjectConnection!

    reward(id: ID!): Reward
    rewards(page: Int = 0, size: Int = 10): RewardConnection!

    pledge(id: ID!): Pledge
    pledges: [Pledge!]!
}

type Mutation {
    createProject(input: CreateProjectInput!): Project!
    updateProject(id: ID!, input: PatchProjectInput!): Project!

    createReward(input: CreateRewardInput!): Reward!

    makePledge(input: CreatePledgeInput!): Pledge!
}