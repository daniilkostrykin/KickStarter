### ===================================================================
### 1. ПОЛЬЗОВАТЕЛИ (Проверка D2: пароль и D3: UserController)
### ===================================================================

### 1.1 Создать нового пользователя (автора)
# @name createUser
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "username": "creator_{{$random.alphanumeric(6)}}",
  "email": "creator_{{$random.alphanumeric(6)}}@test.local"
}

> {%
    client.test("Пользователь создан (201)", function() {
        client.assert(response.status === 201, "Ожидался статус 201, получен: " + response.status);
    });
    client.global.set("userId", response.body.id);
%}

### 1.2 Получить пользователя по ID
GET http://localhost:8080/api/users/{{userId}}
Accept: application/json

> {%
    client.test("Пользователь успешно получен (200)", function() {
        client.assert(response.status === 200, "Ожидался статус 200");
        client.assert(response.body.id === client.global.get("userId"), "ID не совпадает");
    });
%}

### 1.3 Ошибка 404 при запросе несуществующего пользователя
GET http://localhost:8080/api/users/999999
Accept: application/json

> {%
    client.test("Ожидается 404 Not Found", function() {
        client.assert(response.status === 404, "Ожидался статус 404");
    });
%}


### ===================================================================
### 2. ПРОЕКТЫ (Проверка уникальности и обновления)
### ===================================================================

### 2.1 Создать новый проект со случайным именем
# @name createProject
POST http://localhost:8080/api/projects
Content-Type: application/json

{
  "title": "Инновационный проект {{$random.alphanumeric(6)}}",
  "description": "Описание инновационного краудфандингового проекта",
  "goal": 250000.00,
  "deadline": "2026-12-31T23:59:59Z",
  "authorId": {{userId}}
}

> {%
    client.test("Проект успешно создан (201)", function() {
        client.assert(response.status === 201, "Ожидался статус 201");
    });
    client.global.set("projectId", response.body.id);
    client.global.set("projectTitle", response.body.title);
%}

### 2.2 Проверка 409 Conflict при попытке создать проект с тем же title
POST http://localhost:8080/api/projects
Content-Type: application/json

{
  "title": "{{projectTitle}}",
  "description": "Попытка создать дубликат проекта",
  "goal": 100000.00,
  "deadline": "2026-12-31T23:59:59Z",
  "authorId": {{userId}}
}

> {%
    client.test("Успешный перехват дубликата (409 Conflict)", function() {
        client.assert(response.status === 409, "Ожидался статус 409 Conflict, пришел: " + response.status);
    });
%}

### 2.3 Частичное обновление проекта (PATCH)
PATCH http://localhost:8080/api/projects/{{projectId}}
Content-Type: application/json

{
  "status": "ACTIVE"
}

> {%
    client.test("Статус проекта обновлен на ACTIVE (200)", function() {
        client.assert(response.status === 200, "Ожидался статус 200");
        client.assert(response.body.status === "ACTIVE", "Статус не изменился");
    });
%}


### ===================================================================
### 3. НАГРАДЫ (Проверка создания и D1: 404 без падения в 500)
### ===================================================================

### 3.1 Создать награду для проекта
# @name createReward
POST http://localhost:8080/api/rewards
Content-Type: application/json

{
  "title": "Фирменный мерч",
  "description": "Футболка с логотипом проекта",
  "minPrice": 2500.00,
  "projectId": {{projectId}}
}

> {%
    client.test("Награда успешно создана (201)", function() {
        client.assert(response.status === 201, "Ожидался статус 201");
    });
    client.global.set("rewardId", response.body.id);
%}

### 3.2 Проверка 404 для несуществующей награды (Тест дефекта D1)
GET http://localhost:8080/api/rewards/999999
Accept: application/json

> {%
    client.test("Ожидается 404, а не 500 внутренняя ошибка", function() {
        client.assert(response.status === 404, "Сервер вернул " + response.status + " вместо 404");
    });
%}


### ===================================================================
### 4. ВЗНОСЫ (Проверка бизнес-логики и транзакций)
### ===================================================================

### 4.1 Ошибка 400 при взносе меньше minPrice награды
POST http://localhost:8080/api/pledges
Content-Type: application/json

{
  "projectId": {{projectId}},
  "rewardId": {{rewardId}},
  "pledge": 500.00,
  "userId": {{userId}}
}

> {%
    client.test("Валидация минимальной суммы взноса (400 Bad Request)", function() {
        client.assert(response.status === 400, "Ожидался статус 400, получен: " + response.status);
    });
%}

### 4.2 Успешный взнос
POST http://localhost:8080/api/pledges
Content-Type: application/json

{
  "projectId": {{projectId}},
  "rewardId": {{rewardId}},
  "pledge": 5000.00,
  "userId": {{userId}}
}

> {%
    client.test("Взнос успешно создан (201)", function() {
        client.assert(response.status === 201, "Ожидался статус 201");
    });
    client.global.set("pledgeId", response.body.pledgeId);
%}

### 4.3 Проверка 404 для несуществующего взноса (Тест дефекта D1)
GET http://localhost:8080/api/pledges/999999
Accept: application/json

> {%
    client.test("Ожидается 404, а не 500 внутренняя ошибка", function() {
        client.assert(response.status === 404, "Сервер вернул " + response.status + " вместо 404");
    });
%}


### ===================================================================
### 5. GRAPHQL И АУДИТ
### ===================================================================

### 5.1 Выборка проекта со связанным автором и наградами через GraphQL
POST http://localhost:8080/graphql
Content-Type: application/json

{
  "query": "query { project(id: \"{{projectId}}\") { id title status pledged author { id username } rewards { content { id title minPrice } } } }"
}

> {%
    client.test("GraphQL запрос успешен (200)", function() {
        client.assert(response.status === 200, "Ожидался статус 200");
        client.assert(response.body.data.project.title !== null, "Данные проекта пусты");
    });
%}

### 5.2 Проверка аудита (при запущенном kickstarter-audit-service)
GET http://localhost:8081/api/audit?limit=10
Accept: application/json